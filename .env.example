# Cloudflare secrets & local env — never commit real values.
# nuxt-auth-utils requires >= 32 chars; auto-generated in dev if unset.
NUXT_SESSION_PASSWORD=dev-only-session-password-change-me-32chars

# Absolute base URL used to build OTA download_url values (must match deployed host).
NUXT_PUBLIC_APP_URL=http://localhost:3000
